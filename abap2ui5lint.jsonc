{
  // abap2UI5-linter — validates a whole app class without an SAP system:
  // the ABAP and the view it produces, together. Not a view checker: of its
  // five rule groups (metadata, structure, version, data, abap2ui5) the last
  // one is about the relationship between the ABAP class and the view it
  // builds — defects that stay silent at runtime and that no UI5 tooling can
  // see. See AGENTS.md §6 and https://github.com/abap2UI5/linter
  "$schema": "./node_modules/@abap2ui5/linter/data/abap2ui5lint.schema.json",

  "paths": ["src"],

  // The samples must run on the oldest release abap2UI5 supports, so the
  // property gate uses the same 1.71 floor as the rest of the project.
  "ui5": "1.71",
  "distribution": "openui5",

  // The render gate is REQUIRED here, not merely left on. It is on by default,
  // and a default-on gate whose runtime is missing steps aside for the property
  // gate and the run stays green - which for a corpus whose whole claim is that
  // every one of its views loads in a browser would be the wrong kind of quiet.
  // Saying so makes a missing @abap2ui5/render-runtime an error instead.
  "render": true,

  // Adoption-time debt. The corpus only became readable by the linter when it
  // moved onto z2ui5_cl_ui5_view_builder (#752) — before that every class built
  // its view with the retired builder and the linter found nothing to check, so
  // the whole backlog arrived in one run and check-abap2UI5 merged red. The
  // baseline freezes exactly what existed at that moment: those findings are
  // suppressed (counted, never listed), a NEW one fails normally, and an entry
  // whose finding is gone is stale and fails too — so this file only shrinks.
  // Refresh it with `npx abap2ui5lint --update-baseline` after fixing things.
  "baseline": "abap2ui5lint-baseline.json",

  // The two README badges. Every run rewrites these shields.io endpoint
  // files, and they are two because they say two different things:
  //
  //   abap2UI5       | 148 apps - 172 views - 2,176 controls   what is here
  //   check-abap2UI5 | 83 rules passed                         what CI made of it
  //
  // check-abap2UI5 commits them onto the pull request branch, so the badges
  // on main update when the pull request that changed the corpus merges.
  // Together they say something a workflow badge cannot: a green workflow
  // means "the job exited zero", which was also true while the linter found
  // nothing checkable here at all (AGENTS.md 6) - and that run would now
  // print "nothing checkable", grey, on both.
  "badge": [
    { "kind": "corpus", "file": ".github/badges/abap2ui5.json" },
    { "kind": "checks", "file": ".github/badges/check-abap2ui5.json" }
  ],

  // A render error carries no line and its message text is unstable, so it
  // cannot be baselined — naming the file is the only instrument. Two groups,
  // and they are NOT the same thing:
  //
  // (a) what the static harness cannot serve. abap2UI5's own custom controls
  //     (z2ui5/cc/*.js) are delivered by the framework at runtime, and the
  //     SAPUI5 template namespace (…/core/template/1/repeat.js) is not part of
  //     OpenUI5. Nothing to fix in the app.
  //
  // (b) what the RECONSTRUCTION or the sample's own intent makes unjudgeable.
  //     Neither of these is a defect — both were on this list as unresolved
  //     debt and both turned out to be the gate judging something other than
  //     the app. Anything that lands here needs the same treatment: find out
  //     which of the two it is before it is either fixed or excused.
  //       * 343 binds a TYPE REF TO table ON
  //         PURPOSE, inside a TRY, to demonstrate that the framework refuses a
  //         reference ("success - reference not allowed for binding thrown").
  //         The items aggregation therefore gets no template and the render
  //         gate says so - which is the sample's point, not a fault
  //       * 421 is NOT a defect: it builds its ids and paths inside a LOOP,
  //         from the loop variable, so the reconstruction cannot compute them.
  //         The static rules stopped judging that guess in linter 241787b and
  //         a guessed id is made unique, but the guessed BINDING still
  //         resolves to an object in the mock model, which strict property
  //         validation then rejects. The render gate is judging the guess -
  //         nothing here to fix in the app
  //     Take an entry off this list with a fix, or with a reason as specific
  //     as these two.
  //
  // (c) the reconstructor cannot rebuild a view these classes build through a
  //     helper, so there is nothing to render. A gate can say nothing about
  //     them either way.
  "rules": {
    // The chain's layout is the only picture of the view's tree there is, and
    // nothing else formats it: abaplint's `indentation` is off for app code on
    // purpose, so a mangled chain is lint-green everywhere else. Both layout
    // rules ship as `hint`, which `failOn: warning` does not even print - the
    // port to z2ui5_cl_ui5_view_builder (#752) therefore left classes like
    // z2ui5_cl_smp_app_052 with an indent that steps by 2, then by 4, then
    // stops moving, and every gate stayed green.
    //
    // `chain-indentation` is raised here because it costs one baseline entry:
    // it judges only that a chain keeps its OWN rhythm (a sibling in a
    // different column than its siblings, a call written left of the element
    // it belongs to), never the step size, so the corpus already passes it.
    //
    // `chain-element-per-line` is raised too, since the layout unification
    // (AGENTS.md section 10): the convention it used to contradict - a control
    // sharing its line with the container it opens, `view->ele( `Shell`
    // )->ele( `Page`` - is gone, every call now stands on its own line at its
    // own tree level, and the 339 findings with it. That also emptied the
    // baseline of both layout rules, so from here they only guard.
    "chain-indentation": { "severity": "warning" },
    "chain-element-per-line": { "severity": "warning" },

    // src/00/98 is the TEST package (AGENTS.md section 2): apps whose purpose
    // is to exercise the framework from the outside, not to be copied. Several
    // read z2ui5_t_01 - the framework's own draft table - precisely because
    // that is what they assert about. Excluding the folder rather than
    // baselining fourteen entries says WHY they are allowed, and keeps the
    // rule loud for src/01, where a reader would copy it: app 061 was the one
    // real finding this hid, and it is fixed.
    // The pattern is written to match the path in BOTH forms a runner can
    // produce: `abap2ui5lint` reaches these files by an absolute path when
    // `paths` comes from this file, while the report prints them relative.
    // Linter 0.2.0 tries both, so `^src/00/98/` will work there - until the
    // pin moves, a pattern anchored on the folder is the one that holds.
    "non-released-api": { "exclude": ["/00/98/"] },

    /* 0.2.0 brought `missing-on-navigated-branch`, and it is RIGHT: 85 apps
     * here dispatch on check_on_init( ) alone, so nothing re-displays when a
     * called app or a popup hands control back, or when a bookmarked state is
     * restored. abap2UI5/samples-controls made the branch part of its port
     * recipe on the same day - "NOT optional and stays even in a static app
     * with no data and no events".
     *
     * NOT baselined, deliberately. 85 entries would be the biggest suppression
     * this repository has ever carried, and a baseline says "known and
     * accepted" - this is neither. A hint keeps every one of them on the
     * report, where the next person to open an app sees it.
     *
     * Why it is not just fixed here: most of these build the view INLINE
     * inside the IF branch, so each needs its view extracted into a method
     * before an ELSEIF has anything to call. 85 apps, and the samples are what
     * people copy - the conversion has to be done properly, not swept.
     *
     * RAISE THIS BACK to warning as the apps are converted; the last one
     * deletes the line. */
    "missing-on-navigated-branch": "hint",
    "render-error": {
      "exclude": [
        // (a) not served by the harness
        "z2ui5_cl_smp_app_(074|120|143|279|306|327|461|462|463)\\.",
        "z2ui5_cl_smp_app_(173|176)\\.",
        // (b) UNRESOLVED — see above
        "z2ui5_cl_smp_app_(343|421)\\.",
        // (c) helper-built, not reconstructable
        "z2ui5_cl_smp_app_(117|131|185|191|195|211|338)\\."
      ]
    }
  },

  "failOn": "warning"
}
